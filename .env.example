PORT=8099
HOST=127.0.0.1
NODE_ENV=development
# A replica set is required for transactions; Atlas or Docker Compose works.
MONGODB_URI=mongodb://127.0.0.1:27017/group41?replicaSet=rs0&directConnection=true
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin41
ADMIN_PASSWORD=replace-with-your-own-long-password
# false for the course curl demo; true recommended on a public server.
API_AUTH_REQUIRED=false
TRUST_PROXY=false
